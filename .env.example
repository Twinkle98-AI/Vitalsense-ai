# VitalSense AI — Environment Configuration
# Replace placeholder values in your local .env file only.
# Never put real API keys or passwords in this file.

# NVIDIA NIM API
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=your_supported_nvidia_model_id_here

# Flask application
SECRET_KEY=replace_with_a_random_secret_key
FLASK_DEBUG=False